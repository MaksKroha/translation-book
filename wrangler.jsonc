{
  // Cloudflare Worker config. Build: python3 build.py  →  Deploy: npx wrangler deploy
  "name": "translation-book",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // PDFs live in public/protected/ — the Worker must see these requests first to block them.
    "run_worker_first": ["/protected/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookstore",
      "database_id": "bfe2b00b-f577-45f9-833e-34cb4897f35a"
    }
  ],
  "observability": { "enabled": true }
}
