{
  // Cloudflare Worker config. Build: python3 build.py  →  Deploy: npx wrangler deploy
  "name": "translation-book",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // These paths must reach the Worker before the static-asset layer (which would answer them
    // with the 404 page, or 405 for the Buy button's POST). /protected/* holds the PDFs and is blocked.
    "run_worker_first": ["/buy/*", "/pay", "/pay/*", "/api/*", "/download", "/download/*", "/protected/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookstore",
      "database_id": "bfe2b00b-f577-45f9-833e-34cb4897f35a"
    }
  ],
  // Jar poll every 5 minutes (src/worker.js → scheduled), a backup for the monobank webhook.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
